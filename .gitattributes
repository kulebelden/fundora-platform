# Files that run on the Linux server must keep LF line endings, whatever the
# developer's core.autocrlf: a CRLF shell script fails with "pipefail: invalid option".
*.sh text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
apps/api/scripts/*.js text eol=lf
.env.example text eol=lf
