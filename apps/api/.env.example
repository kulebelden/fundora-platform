# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fundora_db
DB_USER=fundora_admin
DB_PASSWORD=super_secret_password
DB_SSL=false

# --- Redis (matches docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (use long random values, at least 32 chars, in every real environment) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
