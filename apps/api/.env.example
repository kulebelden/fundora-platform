# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fundora_db
DB_USER=fundora_admin
DB_PASSWORD=super_secret_password
DB_SSL=false

# --- Redis (matches docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (use long random values, at least 32 chars, in every real environment) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Social sign-in (optional; each provider turns on once all its values are set) ---
# Public origin of the web app. Register these redirect URIs with each provider:
#   ${APP_URL}/api/v1/auth/oauth/google/callback
#   ${APP_URL}/api/v1/auth/oauth/apple/callback   (Apple requires https and a real domain)
APP_URL=http://localhost:3001
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer > Identifiers > Services ID, plus a "Sign in with Apple" key (.p8)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 contents on one line, with newlines written as \n
APPLE_PRIVATE_KEY=

# --- Email (verification links) ---
# false: sign-up skips the emailed link and logs straight in (handy while SMTP is unset)
EMAIL_VERIFICATION_REQUIRED=true
# Any SMTP provider: Gmail (app password), Resend, SendGrid, Mailgun, Amazon SES...
# Leave SMTP_HOST empty in development to print links to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HopeNest <no-reply@your-domain.com>
