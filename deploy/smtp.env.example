# Copy to deploy/.env.smtp (git-ignored), fill in, then run: bash deploy/deploy.sh
# The file is uploaded, merged into the server's .env, and deleted from the server.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
#        https://myaccount.google.com/apppasswords (16 letters, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM=HopeNest <your.address@gmail.com>
#
# Other providers (same keys):
#   Brevo:      smtp-relay.brevo.com  587  (user = Brevo login, pass = SMTP key)
#   Amazon SES: email-smtp.eu-north-1.amazonaws.com  587  (SES SMTP credentials;
#               new accounts must verify the sender and recipients until
#               production access is granted)
